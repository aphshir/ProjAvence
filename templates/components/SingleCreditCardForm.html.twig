<div {{ attributes }}
     class="credit-card-form-component"
     data-controller="card-validation"
>
    {{ form_start(form, {
        'attr': {
            'data-model': 'on(change)|*',
            'class': 'credit-card-single-form'
        }
    }) }}

    <div class="credit-card-item">
        <div class="card-header">
            <span class="card-number-label">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="14" x="2" y="5" rx="2"/>
                    <line x1="2" x2="22" y1="10" y2="10"/>
                </svg>
                {% if isEdit %}
                    {{ 'profile.card.edit_title'|trans }}
                {% else %}
                    {{ 'profile.card.new_title'|trans }}
                {% endif %}
            </span>
        </div>

        <div class="form-group">
            {{ form_label(form.number, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-wrapper">
                {{ form_widget(form.number, {
                    'attr': {
                        'class': 'form-input' ~ (form.number.vars.errors|length ? ' is-invalid' : ''),
                        'data-card-validation-target': 'numberInput',
                        'data-action': 'input->card-validation#validateNumber blur->card-validation#validateNumber'
                    }
                }) }}
                <span class="validation-icon{% if form.number.vars.errors|length %} invalid{% endif %}" data-card-validation-target="numberIcon">
                    {% if form.number.vars.errors|length %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    {% endif %}
                </span>
            </div>
            {{ form_errors(form.number) }}
            <span class="js-validation-error" data-card-validation-target="numberError"></span>
        </div>

        <div class="form-row">
            <div class="form-group form-group-half">
                {{ form_label(form.expirationDate, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-wrapper">
                    {{ form_widget(form.expirationDate, {
                        'attr': {
                            'class': 'form-input' ~ (form.expirationDate.vars.errors|length ? ' is-invalid' : ''),
                            'data-card-validation-target': 'expirationInput',
                            'data-action': 'input->card-validation#validateExpiration blur->card-validation#validateExpiration'
                        }
                    }) }}
                    <span class="validation-icon{% if form.expirationDate.vars.errors|length %} invalid{% endif %}" data-card-validation-target="expirationIcon">
                        {% if form.expirationDate.vars.errors|length %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        {% endif %}
                    </span>
                </div>
                {{ form_errors(form.expirationDate) }}
                <span class="js-validation-error" data-card-validation-target="expirationError"></span>
            </div>

            <div class="form-group form-group-half">
                {{ form_label(form.cvv, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-wrapper">
                    {{ form_widget(form.cvv, {
                        'attr': {
                            'class': 'form-input' ~ (form.cvv.vars.errors|length ? ' is-invalid' : ''),
                            'data-card-validation-target': 'cvvInput',
                            'data-action': 'input->card-validation#validateCvv blur->card-validation#validateCvv'
                        }
                    }) }}
                    <span class="validation-icon{% if form.cvv.vars.errors|length %} invalid{% endif %}" data-card-validation-target="cvvIcon">
                        {% if form.cvv.vars.errors|length %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        {% endif %}
                    </span>
                </div>
                {{ form_errors(form.cvv) }}
                <span class="js-validation-error" data-card-validation-target="cvvError"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button
            type="button"
            class="btn btn-primary"
            data-action="live#action"
            data-live-action-param="save"
            data-loading="addClass(loading)"
        >
            <span class="btn-text">
                {% if isEdit %}
                    {{ 'profile.actions.update'|trans }}
                {% else %}
                    {{ 'profile.actions.save'|trans }}
                {% endif %}
            </span>
            <span class="btn-loading">
                <svg class="spinner" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <circle class="spinner-circle" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="3"/>
                </svg>
            </span>
        </button>
        <a href="{{ path('app_profile') }}" class="btn btn-secondary">
            {{ 'profile.actions.cancel'|trans }}
        </a>
    </div>

    {{ form_end(form) }}
</div>
