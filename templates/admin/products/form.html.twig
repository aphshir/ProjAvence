{% extends 'layouts/admin_layout.html.twig' %}

{% block title %}
    {% if isEdit %}
        {{ 'admin.products.edit_product'|trans }} - NightMarket
    {% else %}
        {{ 'admin.products.create_product'|trans }} - NightMarket
    {% endif %}
{% endblock %}

{% block content %}
<div class="admin-header">
    <h1>
        {% if isEdit %}
            {{ 'admin.products.edit_product'|trans }}
        {% else %}
            {{ 'admin.products.create_product'|trans }}
        {% endif %}
    </h1>
</div>

{{ form_start(form, {'attr': {'class': 'product-form-bento', 'data-controller': 'image-collection'}}) }}

    <div class="bento-card section-general">
        <h2 class="bento-card-title">{{ 'admin.products.form.section_general'|trans }}</h2>

        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.description) }}
        </div>
    </div>

    <div class="bento-card section-classification">
        <h2 class="bento-card-title">{{ 'admin.products.form.section_classification'|trans }}</h2>

        <div class="form-group">
            {{ form_label(form.category) }}
            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.category) }}
        </div>

        <div class="form-group">
            {{ form_label(form.status) }}
            {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.status) }}
        </div>
    </div>

    <div class="bento-card section-pricing">
        <h2 class="bento-card-title">{{ 'admin.products.form.section_pricing'|trans }}</h2>

        <div class="pricing-grid">
            <div class="form-group">
                {{ form_label(form.price) }}
                {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.price) }}
            </div>

            <div class="form-group">
                {{ form_label(form.stock) }}
                {{ form_widget(form.stock, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.stock) }}
            </div>
        </div>
    </div>

    <div class="bento-card section-status">
        <h2 class="bento-card-title">{{ 'admin.products.form.section_info'|trans }}</h2>

        {% if isEdit %}
            <p style="color: var(--text-secondary); font-size: 0.875rem;">
                {{ 'admin.products.form.product_id'|trans }}: <strong>#{{ product.id }}</strong>
            </p>
        {% endif %}

        <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 1rem;">
            {{ 'admin.products.form.help_text'|trans }}
        </p>
    </div>

    <div class="bento-card section-media">
        <div class="section-header">
            <div class="section-title-with-info">
                <h2 class="bento-card-title">{{ 'admin.products.form.section_media'|trans }}</h2>
                <div class="info-icon-wrapper">
                    <svg class="info-icon" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                    <div class="info-tooltip">
                        {{ 'admin.products.form.gallery_info'|trans }}
                    </div>
                </div>
            </div>
        </div>

        <div class="drop-zone" data-image-collection-target="dropZone">
            <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-image-collection-target="fileInput" data-action="change->image-collection#handleFileSelect" style="position: absolute; width: 100%; height: 100%; top: 0; left: 0; opacity: 0; cursor: pointer;">
            <svg class="drop-zone-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
            </svg>
            <p class="drop-zone-title">{{ 'admin.products.form.carousel_upload_title'|trans }}</p>
            <p class="drop-zone-subtitle">{{ 'admin.products.form.carousel_upload_subtitle'|trans }}</p>
        </div>

        <div class="image-cards-grid" data-image-collection-target="cardsGrid">
            {% for imageForm in form.images %}
                <div class="image-card" data-index="{{ loop.index0 }}" data-image-collection-target="imageCard">
                    <div class="card-drag-handle">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M7 2a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zM7 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zM7 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-3 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-3 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                    </div>

                    <div class="card-image-preview">
                        {% if imageForm.vars.data and imageForm.vars.data.url %}
                            <img src="{{ imageForm.vars.data.url }}" alt="{{ imageForm.vars.data.altText }}">
                        {% else %}
                            <div class="card-placeholder">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                        {% endif %}
                    </div>

                    <div class="card-badges">
                        {% if imageForm.vars.data.isPrimary %}
                            <span class="badge badge-primary">⭐ {{ 'admin.products.form.primary'|trans }}</span>
                        {% endif %}
                        <span class="badge badge-position">#{{ loop.index }}</span>
                    </div>

                    <div class="card-actions">
                        <button type="button" class="card-action-btn"
                                data-action="click->image-collection#setCardAsPrimary"
                                title="{{ 'admin.products.actions.set_primary'|trans }}">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                            </svg>
                        </button>
                        <button type="button" class="card-action-btn danger"
                                data-action="click->image-collection#deleteCard"
                                title="{{ 'admin.products.actions.delete'|trans }}">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4L4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div style="display: none;" data-image-collection-target="collection" data-prototype="{{ form_widget(form.images.vars.prototype)|e('html_attr') }}">
            {% for imageForm in form.images %}
                <div class="image-data-container" data-index="{{ loop.index0 }}">
                    {{ form_widget(imageForm.uploadType, {'attr': {'class': 'upload-type-field'}}) }}
                    {{ form_widget(imageForm.url, {'attr': {'class': 'url-field'}}) }}
                    {{ form_widget(imageForm.file, {'attr': {'class': 'file-field'}}) }}
                    {{ form_widget(imageForm.altText, {'attr': {'class': 'alt-text-field'}}) }}
                    {{ form_widget(imageForm.position) }}
                    {{ form_widget(imageForm.isPrimary, {'attr': {'class': 'is-primary-field'}}) }}
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="form-actions-sticky">
        <a href="{{ path('app_admin_products') }}" class="btn btn-secondary">
            {{ 'admin.products.actions.cancel'|trans }}
        </a>
        <button type="submit" class="btn btn-primary">
            {% if isEdit %}
                {{ 'admin.products.actions.update'|trans }}
            {% else %}
                {{ 'admin.products.actions.create'|trans }}
            {% endif %}
        </button>
    </div>

{{ form_rest(form) }}
{{ form_end(form) }}
{% endblock %}
