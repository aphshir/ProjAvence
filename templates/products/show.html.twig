{% extends 'layouts/main_layout.html.twig' %}

{% block title %}{{ product.name }} - NightMarket{% endblock %}

{% block content %}
<div class="product-detail-page">
    <a href="{{ path('app_products') }}" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        {{ 'product.back_to_products'|trans }}
    </a>

    <div class="product-detail">
        <div class="product-gallery">
            {% if product.images|length > 0 %}
                <div class="gallery-main">
                    {% for key, image in product.images %}
                        <input
                            type="radio"
                            name="gallery-image"
                            id="image-{{ key }}"
                            class="gallery-radio"
                            {% if key == 0 %}checked{% endif %}
                            hidden
                        >
                    {% endfor %}

                    <div class="gallery-display">
                        {% for key, image in product.images %}
                            <img
                                src="{{ image.url }}"
                                alt="{{ image.altText }}"
                                class="gallery-image gallery-image-{{ key }}"
                            >
                        {% endfor %}
                    </div>
                </div>

                {% if product.images|length > 1 %}
                    <div class="gallery-thumbnails">
                        {% for key, image in product.images %}
                            <label for="image-{{ key }}" class="gallery-thumbnail">
                                <img src="{{ image.url }}" alt="{{ image.altText }}">
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                <div class="gallery-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                </div>
            {% endif %}
        </div>

        <div class="product-info">
            <div class="product-header">
                <a href="{{ path('app_products') }}?category={{ product.category.id }}" class="category-tag">
                    {{ product.category.name }}
                </a>
                <h1 class="product-name">{{ product.name }}</h1>
            </div>

            <div class="product-price-block">
                <div class="price-row">
                    <span class="product-price">{{ product.price|number_format(2, '.', ',') }} €</span>
                    {% if product.status.value == 'en_rupture' %}
                        <span class="product-badge badge-out-of-stock">
                            {{ 'product_status.en_rupture'|trans }}
                        </span>
                    {% elseif product.status.value == 'en_precommande' %}
                        <span class="product-badge badge-preorder">
                            {{ 'product_status.en_precommande'|trans }}
                        </span>
                    {% else %}
                        <span class="product-badge badge-available">
                            {{ 'product_status.disponible'|trans }}
                        </span>
                    {% endif %}
                </div>
                <div class="stock-info {% if product.stock == 0 %}stock-out{% elseif product.stock < 5 %}stock-low{% else %}stock-ok{% endif %}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                    {{ 'product.stock_available'|trans({'%count%': product.stock}, 'messages') }}
                </div>
            </div>

            {% if product.status.value != 'en_rupture' %}
                <div class="product-actions" data-controller="cart" data-cart-locale-value="{{ app.request.locale }}" data-cart-text-adding-value="{{ 'cart.adding'|trans }}" data-cart-text-added-value="{{ 'cart.added'|trans }}">
                    <div class="quantity-selector">
                        <button type="button" class="quantity-btn" onclick="decreaseQuantity()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                        <input
                            type="number"
                            id="quantity"
                            name="quantity"
                            value="1"
                            min="1"
                            max="{{ product.stock }}"
                            class="quantity-input"
                        >
                        <button type="button" class="quantity-btn" onclick="increaseQuantity({{ product.stock }})">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                    </div>
                    <button class="btn-add-to-cart"
                            data-action="cart#addToCart"
                            data-cart-product-id-param="{{ product.id }}"
                            data-cart-max-stock-param="{{ product.stock }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        {{ 'common.add_to_cart'|trans }}
                    </button>
                </div>
            {% else %}
                <div class="product-actions">
                    <button class="btn-unavailable" disabled>
                        {{ 'common.add_to_cart'|trans }}
                    </button>
                </div>
            {% endif %}

            <div class="product-description">
                <h2>{{ 'product.description'|trans }}</h2>
                <p>{{ product.description }}</p>
            </div>
        </div>
    </div>

    {% if relatedProducts|length > 0 %}
        <div class="related-products-section">
            <h2 class="related-products-title">{{ 'product.related_products'|trans }}</h2>

            <div class="related-products-grid">
                {% for relatedProduct in relatedProducts %}
                    <a href="{{ path('app_product_show', {slug: relatedProduct.slug}) }}" class="related-product-card">
                        <div class="related-product-image-wrapper">
                            {% if relatedProduct.images|length > 0 %}
                                {% set primaryImage = relatedProduct.images|first %}
                                <img
                                    src="{{ primaryImage.url }}"
                                    alt="{{ primaryImage.altText }}"
                                    class="related-product-image"
                                    loading="lazy"
                                >
                            {% else %}
                                <div class="related-product-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                </div>
                            {% endif %}

                            {% if relatedProduct.status.value == 'en_rupture' %}
                                <span class="related-product-badge badge-out-of-stock">
                                    {{ 'product_status.en_rupture'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="related-product-content">
                            <h3 class="related-product-name">{{ relatedProduct.name }}</h3>
                            <span class="related-product-price">{{ relatedProduct.price|number_format(2, '.', ',') }} €</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>

<script>
function increaseQuantity(max) {
    const input = document.getElementById('quantity');
    const currentValue = parseInt(input.value);
    if (currentValue < max) {
        input.value = currentValue + 1;
    }
}

function decreaseQuantity() {
    const input = document.getElementById('quantity');
    const currentValue = parseInt(input.value);
    if (currentValue > 1) {
        input.value = currentValue - 1;
    }
}
</script>
{% endblock %}
