<div {{ attributes }}>
    <div class="products-search-controls">
        <div class="search-box">
            <div class="search-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
            <input
                type="text"
                class="search-input"
                placeholder="{{ 'products.search_placeholder'|trans }}"
                data-model="query"
                data-loading="addClass(loading)"
            >
            <div class="search-loading">
                <span class="spinner"></span>
            </div>
        </div>

        <div class="sort-dropdown">
            <label for="sort-select">{{ 'products.sort_by'|trans }}</label>
            <select id="sort-select" class="sort-select" data-model="sort">
                <option value="name_asc" {% if sort == 'name_asc' %}selected{% endif %}>
                    {{ 'products.sort_name_asc'|trans }}
                </option>
                <option value="price_asc" {% if sort == 'price_asc' %}selected{% endif %}>
                    {{ 'products.sort_price_asc'|trans }}
                </option>
                <option value="price_desc" {% if sort == 'price_desc' %}selected{% endif %}>
                    {{ 'products.sort_price_desc'|trans }}
                </option>
                <option value="newest" {% if sort == 'newest' %}selected{% endif %}>
                    {{ 'products.sort_newest'|trans }}
                </option>
            </select>
        </div>
    </div>

    {% set pagination = this.pagination %}

    {% if query is not empty %}
        <div class="search-results-info">
            <p class="results-count">
                {{ 'products.search_results'|trans({'%count%': pagination.totalItemCount, '%query%': query}) }}
            </p>
        </div>
    {% endif %}

    {% if pagination.totalItemCount > 0 %}
        <div class="products-grid">
            {% for product in pagination %}
                <article class="product-card">
                    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="product-link">
                        <div class="product-image-wrapper">
                            {% if product.images|length > 0 %}
                                {% set primaryImage = product.images|first %}
                                <img
                                    src="{{ primaryImage.url }}"
                                    alt="{{ primaryImage.altText }}"
                                    class="product-image"
                                    loading="lazy"
                                >
                            {% else %}
                                <div class="product-image-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                </div>
                            {% endif %}

                            {% if product.status.value == 'en_rupture' %}
                                <span class="product-badge product-badge-out-of-stock">
                                    {{ 'product_status.en_rupture'|trans }}
                                </span>
                            {% elseif product.status.value == 'en_precommande' %}
                                <span class="product-badge product-badge-preorder">
                                    {{ 'product_status.en_precommande'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="product-content">
                            <h2 class="product-name">{{ product.name }}</h2>

                            <div class="product-footer">
                                <div class="product-price-section">
                                    <span class="product-price">{{ product.price|number_format(2, '.', ',') }} EUR</span>
                                    {% if product.stock > 0 %}
                                        <span class="product-stock">{{ 'products.in_stock'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
            {% endfor %}
        </div>

        {% if pagination.totalItemCount > pagination.itemNumberPerPage %}
            <div class="pagination-container">
                <div class="pagination-info">
                    {{ 'pagination.showing'|trans({'%start%': ((page - 1) * pagination.itemNumberPerPage) + 1, '%end%': min(page * pagination.itemNumberPerPage, pagination.totalItemCount), '%total%': pagination.totalItemCount}) }}
                </div>
                <nav class="pagination">
                    {% set pageCount = (pagination.totalItemCount / pagination.itemNumberPerPage)|round(0, 'ceil') %}

                    {% if page > 1 %}
                        <button type="button" class="pagination-link pagination-first" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="1" title="{{ 'pagination.first'|trans }}">
                            &laquo;
                        </button>
                        <button type="button" class="pagination-link pagination-prev" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ page - 1 }}" title="{{ 'pagination.previous'|trans }}">
                            &lsaquo;
                        </button>
                    {% else %}
                        <span class="pagination-link pagination-first disabled">&laquo;</span>
                        <span class="pagination-link pagination-prev disabled">&lsaquo;</span>
                    {% endif %}

                    {% set startPage = max(1, page - 2) %}
                    {% set endPage = min(pageCount, page + 2) %}

                    {% if startPage > 1 %}
                        <button type="button" class="pagination-link" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="1">1</button>
                        {% if startPage > 2 %}
                            <span class="pagination-ellipsis">...</span>
                        {% endif %}
                    {% endif %}

                    {% for p in startPage..endPage %}
                        {% if p == page %}
                            <span class="pagination-link active">{{ p }}</span>
                        {% else %}
                            <button type="button" class="pagination-link" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ p }}">{{ p }}</button>
                        {% endif %}
                    {% endfor %}

                    {% if endPage < pageCount %}
                        {% if endPage < pageCount - 1 %}
                            <span class="pagination-ellipsis">...</span>
                        {% endif %}
                        <button type="button" class="pagination-link" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ pageCount }}">{{ pageCount }}</button>
                    {% endif %}

                    {% if page < pageCount %}
                        <button type="button" class="pagination-link pagination-next" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ page + 1 }}" title="{{ 'pagination.next'|trans }}">
                            &rsaquo;
                        </button>
                        <button type="button" class="pagination-link pagination-last" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ pageCount }}" title="{{ 'pagination.last'|trans }}">
                            &raquo;
                        </button>
                    {% else %}
                        <span class="pagination-link pagination-next disabled">&rsaquo;</span>
                        <span class="pagination-link pagination-last disabled">&raquo;</span>
                    {% endif %}
                </nav>
            </div>
        {% endif %}
    {% else %}
        <div class="products-empty">
            {% if query is not empty %}
                <p>{{ 'products.no_results'|trans({'%query%': query}) }}</p>
            {% else %}
                <p>{{ 'products.no_products'|trans }}</p>
            {% endif %}
        </div>
    {% endif %}
</div>
