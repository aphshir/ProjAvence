{% extends 'layouts/main_layout.html.twig' %}

{% block title %}{{ 'auth.register.title'|trans }}{% endblock %}

{% block content %}
<div class="auth-container">
    <div class="auth-card">
        <h1>{{ 'auth.register.title'|trans }}</h1>

        {{ form_start(registrationForm) }}
            <div class="form-group">
                {{ form_label(registrationForm.email, 'auth.register.email'|trans, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.firstName, 'auth.register.firstname'|trans, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(registrationForm.firstName) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.lastName, 'auth.register.lastname'|trans, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(registrationForm.lastName) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.password.first, 'auth.register.password'|trans, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.password.first, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(registrationForm.password.first) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.password.second, 'auth.register.password_confirm'|trans, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.password.second, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(registrationForm.password.second) }}
            </div>

            <button type="submit" class="btn">{{ 'auth.register.submit'|trans }}</button>
        {{ form_end(registrationForm) }}

        <div class="auth-footer">
            <p>{{ 'auth.register.have_account'|trans }} <a href="{{ path('app_login') }}">{{ 'auth.register.login_link'|trans }}</a></p>
        </div>
    </div>
</div>
{% endblock %}
